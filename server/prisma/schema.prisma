generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    ADMIN
    MANAGER
    ACCOUNTANT
}

enum PropertyManagementType {
    UNKNOWN
    WEG
    MV
}

enum PropertyStatus {
    DRAFT
    ACTIVE
}

model User {
    id        String   @id @default(uuid()) @db.Uuid
    email     String   @unique @db.VarChar(255)
    name      String   @db.VarChar(200)
    role      UserRole
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    managedProperties   Property[] @relation("PropertyManager")
    accountedProperties Property[] @relation("PropertyAccountant")
    Session             Session[]

    @@index([role])
}

model Session {
    id        String   @id @default(uuid()) @db.Uuid
    userId    String   @db.Uuid
    createdAt DateTime @default(now())
    lastSeen  DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Property {
    id             String                 @id @default(uuid()) @db.Uuid
    propertyNumber Int                    @unique
    name           String                 @db.VarChar(255)
    managementType PropertyManagementType
    status         PropertyStatus         @default(DRAFT)

    managerId    String? @db.Uuid
    accountantId String? @db.Uuid

    addressStreet     String? @db.VarChar(255)
    addressPostalCode String? @db.VarChar(20)
    addressCity       String? @db.VarChar(100)

    documentName       String?   @db.VarChar(255)
    documentMimeType   String?   @db.VarChar(100)
    documentData       Bytes?
    documentUploadedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    manager    User? @relation("PropertyManager", fields: [managerId], references: [id], onDelete: Restrict)
    accountant User? @relation("PropertyAccountant", fields: [accountantId], references: [id], onDelete: Restrict)
    sections   PropertySection[]

    basicDetailsExtract   Json?
    basicDetailsExtractedAt DateTime?

    @@index([status])
    @@index([managementType])
    @@index([managerId])
    @@index([accountantId])
}

model PropertySection {
    id           String   @id @default(uuid()) @db.Uuid
    propertyId   String   @db.Uuid
    sectionIndex Int
    headingText  String   @db.Text
    rawText      String   @db.Text
    textPosition Json
    sectionType  String   @db.VarChar(80)
    confidence   Float
    renderable   Boolean  @default(true)
    items        Json?    // For array-based sections (buildings, units) - stores SectionItem[]
    createdAt    DateTime @default(now())

    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    @@index([propertyId])
    @@unique([propertyId, sectionIndex])
}

model PropertyCounter {
    id      Int @id @default(1)
    current Int @default(0)
}
