{
  "name": "beuna-dashboard",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "server:dev": "bun run --watch server/src/server.ts",
    "prisma:dev:init": "dotenv -e .env.development -- bun run --cwd ./server prisma:init",
    "prisma:dev:seed": "dotenv -e .env.development -- bun run --cwd ./server prisma:seed",
    "prisma:dev:generate": "dotenv -e .env.development -- bun run --cwd ./server prisma:generate",
    "prisma:dev:migrate": "dotenv -e .env.development -- bun run --cwd ./server prisma:migrate"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.5",
    "@prisma/client": "^6.14.0",
    "fastify": "^5.7.4",
    "framer-motion": "^12.34.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.14.0",
    "vitest": "^4.0.18"
  }
}
