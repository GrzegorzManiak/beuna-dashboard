{
  "name": "beuna-dashboard",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"bun run server:dev\" \"bun run client:dev\"",
    "server:dev": "bun run --cwd ./server dev",
    "client:dev": "bun run --cwd ./client dev",
    "client:build": "bun run --cwd ./client build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.20",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^5.1.4",
    "framer-motion": "^12.34.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "concurrently": "^9.2.1"
  }
}
