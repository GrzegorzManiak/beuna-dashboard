{
  "name": "beuna-dashboard",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"bun run server:dev\" \"bun run client:dev\"",
    "prod": "concurrently -n server,client -c blue,green \"bun run server:prod\" \"bun run client:prod\"",

    "server:dev": "dotenv -e .env.development -- bun run --cwd ./server dev",
    "server:prod": "dotenv -e .env.production -- bun run --cwd ./server start",

    "client:dev": "bun run --cwd ./client dev",
    "client:build": "bun run --cwd ./client build",
    "client:preview": "bun run --cwd ./client preview",

    "prisma:dev:init": "dotenv -e .env.development -- bun run --cwd ./server prisma:init",
    "prisma:dev:seed": "dotenv -e .env.development -- bun run --cwd ./server prisma:seed",
    "prisma:dev:generate": "dotenv -e .env.development -- bun run --cwd ./server prisma:generate",
    "prisma:dev:migrate": "dotenv -e .env.development -- bun run --cwd ./server prisma:migrate",
    "prisma:dev:reset": "dotenv -e .env.development -- bun run --cwd ./server prisma:reset",

    "prisma:prod:generate": "dotenv -e .env.production -- bun run --cwd ./server prisma:generate",
    "prisma:prod:migrate": "dotenv -e .env.production -- bunx prisma migrate deploy --schema ./server/prisma/schema.prisma",
    "prisma:prod:seed": "dotenv -e .env.production -- bun run --cwd ./server prisma:seed",
    "prisma:prod:init": "bun run prisma:prod:generate && bun run prisma:prod:migrate && bun run prisma:prod:seed"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/multipart": "^9.0.3",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^6.14.0",
    "@tanstack/react-query": "^5.90.20",
    "@types/react": "^19.2.14",
    "fastify": "^5.7.4",
    "framer-motion": "^12.34.0",
    "unpdf": "^1.3.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "@types/node": "^25.2.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.14.0",
    "vitest": "^4.0.18"
  }
}
